<!DOCTYPE html>
<html>
<head>
  <title>Blog App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
  <h1>Make new posts</h1>
  <form action="/blog" method="POST">
    <label>Name:</label>
    <input type="text" name="name" required>

    <label>Title:</label>
    <input type="text" name="title" required>

    <label>Content:</label>
    <textarea name="content" required></textarea>

    <button type="submit">Post</button>
  </form>

  <!-- For video -->
  <hr>
  <section class="joke-box">
  <h2>Tell Me a Joke</h2>
  <form action="/joke" method="POST">
    <label>Category:</label>
    <select name="category">
      <option value="Any">Any</option>
      <option value="Programming">Programming</option>
      <option value="Pun">Pun</option>
      <option value="Misc">Misc</option>
    </select>
    <button type="submit">Get Joke</button>
  </form>

  <% if (locals.joke) { %>
    <p class="joke"><%= joke %></p>
  <% } %>
  <% if (locals.error) { %>
    <p class="error"><%= error %></p>
  <% } %>
</section>
<hr>

  <h2>Posts</h2>
  <% posts.forEach(function(post) { %>
  <div class="post">
    <h3><%= post.title %></h3>
    <p><%= post.content %></p>
    <p><em><%= post.name %> on <%= post.createdAt.toLocaleString() %></em></p>

    <a href="/blog/<%= post.id %>/edit">Edit</a>

    <form action="/blog/<%= post.id %>?_method=DELETE" method="POST" style="display:inline;">
      <button type="submit">Delete</button>
    </form>
  </div>
  <% }); %>
</body>

</html>